# Сайт Малмыжского ремзавода — systemd-юнит прод-сервера (Next standalone, стадия 2).
# ТРЕТИЙ жилец Бокса Sabantuy (1.5 GiB без swap): Sabantuy MemoryMax=1024M (RSS ~265M),
# Kazanskaya 768M (~265M) — РМЗ даём 512M (ожидаемый RSS ~250M). Сумма лимитов
# overcommit к физике, фактические RSS влезают с запасом; при тесноте — capacity-probe
# и эскалация мозгу.
# Артефакт собирается в CI и распаковывается в releases/<sha>; current → симлинк.
# Установка на сервере (делает setup-prod-stage2.yml):
#   sudo cp deploy/rmz.service /etc/systemd/system/rmz.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now rmz
[Unit]
Description=RMZ Malmyzh site (Next.js standalone)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=valstan
WorkingDirectory=/home/valstan/rmz/current
# Секреты (DATABASE_URL, PAYLOAD_SECRET, PORT=3002, HOSTNAME, MEDIA_DIR, …) — вне репо (#008).
EnvironmentFile=/etc/rmz/rmz.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3
MemoryMax=512M
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
