# /etc/rmz/rmz.env — прод-секреты вне репо (#008). В git — только этот пример.
# Реальный файл создаёт setup-prod-stage2.yml (пароли генерируются на боксе).

# Отдельная БД и роль на общем PG-инстансе бокса (как sabantuy/kazanskaya)
DATABASE_URL=postgresql://rmz_app:CHANGE_ME@localhost:5432/rmz

PAYLOAD_SECRET=CHANGE_ME_32_RANDOM_CHARS

# Порт сервиса (задаёт setup-prod-stage2.yml)
PORT=3002
HOSTNAME=127.0.0.1

# Боевой домен — строго punycode (G133/G134)
NEXT_PUBLIC_SERVER_URL=https://xn--g1ajl.xn--80adkdyec4j.xn--p1ai
NEXT_PUBLIC_SITE_URL=https://xn--g1ajl.xn--80adkdyec4j.xn--p1ai

# Персистентное медиа вне релиз-директории (G146)
MEDIA_DIR=/home/valstan/rmz/shared/media

# Лента новостей из VK. Ключ шлюза кладёт apply-gateway-key.yml (из vault по
# grant), ключ приёмника генерирует import-novosti.yml на боксе при первом
# прогоне — оба только через воркфлоу, не руками.
# SARAFAN_GATEWAY_URL=
# SARAFAN_GATEWAY_KEY=
# VK_RMZ_OWNER_ID=-195583920
# NOVOSTI_INGEST_KEY=

# Формы: секреты пишет apply-form-secrets.yml (dispatch), не руками.
# SmartCaptcha: капча rmz-malmyzh в Яндекс Облаке (облако sabantuymalm);
# клиентский ключ — vars.NEXT_PUBLIC_SMARTCAPTCHA_KEY, бейкается при сборке.
# SMARTCAPTCHA_SERVER_KEY=
# SMTP-дубль заявок (ящик владельца на Яндекс-почте, как у Сабантуя;
# SMTP_FROM_ADDRESS обязан совпадать с SMTP_USER — иначе relay отклонит)
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=valstan@valstan.ru
# SMTP_PASS=
# SMTP_FROM_ADDRESS=valstan@valstan.ru
